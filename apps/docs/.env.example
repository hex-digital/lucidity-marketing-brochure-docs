NEXT_PUBLIC_NO_INDEX=true
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# Public docs URL (include /docs when docs use basePath /docs). Multi-zone local: http://localhost:3000/docs — docs-only dev: http://localhost:3001/docs
NEXT_PUBLIC_DOCS_URL=http://localhost:3000/docs
# Optional: hostname that still points at this docs deployment (e.g. docs.lucidityjs.com). When set, 301 to NEXT_PUBLIC_WEB_URL + path; / → NEXT_PUBLIC_DOCS_URL
# NEXT_PRIVATE_DOCS_LEGACY_HOST=docs.lucidityjs.com
NEXT_PUBLIC_DOCS_FEEDBACK_SLACK_CHANNEL_ID=C1234567890
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_FEEDBACK_API_BASE_URL=http://127.0.0.1:4010
